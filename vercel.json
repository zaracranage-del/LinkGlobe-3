{
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/terms",   "destination": "/terms.html"   },
    {
      "source": "/:handle((?!api|_next|favicon|dashboard|login|onboarding|privacy|terms|reset-password|404|debug|supabasesetup|pro-dashboard-preview|storefront-preview|reel|social-posts|logo|admin|support|help|about|contact|blog|www|app|linkglobe)[^/]+)",
      "destination": "/storefront.html"
    }
  ]
}
